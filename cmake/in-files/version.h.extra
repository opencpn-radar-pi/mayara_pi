// Short git commit id and channel (alpha/beta.N/prod/dev) this binary was
// built from, baked in so mayara_pi::GetPlugInVersionBuild() can report them
// (see CMakeLists.txt for how PLUGIN_GIT_COMMIT/PLUGIN_CHANNEL are
// computed). Every alpha/beta build shares the same
// PLUGIN_VERSION_{MAJOR,MINOR,PATCH} until the next release bumps them in
// CMakeLists.txt, so without this OpenCPN's plugin manager can't tell two
// different builds -- or which channel one came from -- apart.
#define PLUGIN_VERSION_COMMIT "${PLUGIN_GIT_COMMIT}+${PLUGIN_CHANNEL}"
